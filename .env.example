# Copy to .env (git-ignored) and adjust. Never commit real tokens.
# Environment variables set in the shell or CI take precedence over this file.

# Browser suite: app under test. Default: https://demo.playwright.dev/todomvc/
# Must not contain a username, password, query string or fragment.
UI_BASE_URL=

# Login setup, only for clients with ui.login in their client config (see clients/login-demo/README.md).
# Never commit these. Prefer CI secrets; in .env they stay local (the file is git-ignored).
# Both are masked in reports. The signed-in browser state is saved to playwright/.auth/ (git-ignored).
UI_USERNAME=
UI_PASSWORD=

# jsonplaceholder (default) | qa | staging
API_ENV=jsonplaceholder

# Required for qa and staging; optional override for jsonplaceholder.
# Must not contain a username, password, query string or fragment; use API_TOKEN for auth.
API_BASE_URL=

# Optional. Sent as "Authorization: Bearer <token>". Provide via shell/CI secrets.
# While set, API and combined runs skip the HTML report (it could contain the token).
API_TOKEN=

# Per-request timeout in milliseconds.
API_TIMEOUT_MS=10000

# Optional override: "true" skips write (POST/PUT/PATCH/DELETE) tests.
API_READ_ONLY=

# Production guard. Targets marked production in the client config, or on its productionHosts,
# are refused unless this is "true". Production API runs are always read-only.
ALLOW_PRODUCTION=

# Diagnostics. Video: off | on | retain-on-failure | on-first-retry (default).
PW_VIDEO=

# Redacted "api-calls" attachment (last 20 calls) on failed API tests: on-failure (default) | off.
# Send secrets in headers or bodies, never in URL query strings: the attachment and reports mask
# query parameters with known sensitive names (token, password, session, ...), but not others.
PW_API_CALLS=

# HTML report: auto (default; skipped while API_TOKEN is set) | always (local debugging only).
PW_HTML_REPORT=

# Reports and redaction (no variable to set):
# - A redacting reporter runs first and masks the token, cookies and sensitive headers, query
#   parameters and fields in what Playwright stores (errors, steps, test output, text attachments)
#   before the HTML and JUnit reports are written. Runs that would skip it are refused: add
#   reporters with --add-reporter=<name>, or list it first in --reporter.
# - "playwright test --list" writes no HTML or JUnit report, so it never replaces existing ones.
#   A list run that adds a reporter which writes files (--add-reporter=html, ...) is refused.
# - Text attachment files inside the run's test-results folder are redacted in place, e.g. the
#   failure snapshot (error-context.md), which shows values typed into form fields. Binary files
#   (screenshots, videos, traces) and files outside that folder are not.
# - Terminal output is NOT redacted. Playwright prints progress, errors and anything tests write
#   to stdout/stderr to the terminal as it happens, outside the redaction. Treat terminal and CI
#   logs as possibly containing secrets: do not share them raw, and keep CI secret masking on.
