# Copy to .env (git-ignored) and adjust. Never commit real tokens.
# Environment variables set in the shell or CI take precedence over this file.

# jsonplaceholder (default) | qa | staging
API_ENV=jsonplaceholder

# Required for qa and staging; optional override for jsonplaceholder.
API_BASE_URL=

# Optional. Sent as "Authorization: Bearer <token>". Provide via shell/CI secrets.
API_TOKEN=

# Per-request timeout in milliseconds.
API_TIMEOUT_MS=10000

# Optional override: "true" skips write (POST/PUT/PATCH/DELETE) tests.
API_READ_ONLY=
